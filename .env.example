# Django GraphQL MCP Server Configuration

# GraphQL endpoint URL (default: http://localhost:8000/graphql)
ENDPOINT=http://localhost:8000/graphql

# Authentication headers as JSON string (default: {})
# Example: {"Authorization": "Bearer your-token", "X-API-Key": "your-key"}
HEADERS={}

# Allow mutations (default: false)
ALLOW_MUTATIONS=false

# MCP server display name (default: django-graphql-mcp-server)
NAME=django-graphql-mcp-server

# Optional: Path to local GraphQL schema file
# SCHEMA=./schema.graphql